{
  "version": 2,


  "settings": {

    "appearanceTools": true,

    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vh",
        "vw"
      ]
    },

    "layout": {
      "contentSize": "var(--theme-block-max-width)",
      "wideSize": "var(--theme-block-wide-max-width)",
      "fullSize": "none"
    },

    "typography": {
      "fluid": true,
      "fontSizes": [
        {
          "fluid": {
            "min": "`12px",
            "max": "13px"
          },
          "size": "13px",
          "slug": "small"
        },
        {
          "fluid": {
            "min": "15px",
            "max": "17px"
          },
          "size": "17px",
          "slug": "medium"
        },
        {
          "fluid": {
            "min": "18px",
            "max": "20px"
          },
          "size": "20px",
          "slug": "large"
        },
        {
          "fluid": {
            "min": "28px",
            "max": "32px"
          },
          "size": "32px",
          "slug": "x-large"
        },
        {
          "fluid": {
            "min": "34px",
            "max": "42px"
          },
          "size": "42px",
          "slug": "xx-large"
        }
      ]
    }
  },


  "styles": {
    "elements": {
      "link": {
        "typography": {
          "textDecoration": false
        }
      },
      "button": {
        "spacing": {
          "padding": false
        },
        "border": {
          "width": false
        },
        "color": {
          "background": false,
          "text": false
        },
        "typography": {
          "fontFamily": false,
          "fontSize": false,
          "lineHeight": false,
          "textDecoration": false
        }
      }
    },

    "spacing": {
      "blockGap": "var(--theme-content-spacing)"
    }
  }
}